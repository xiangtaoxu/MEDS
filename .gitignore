# ---- Fortran build artifacts ----
*.o
*.obj
*.mod
*.smod
*.a
*.so
*.dylib
*.dll
*.lib
*.lst
*.optrpt
*.gcno
*.gcda
genmod.f90
genmod.mod

# ---- Build trees ----
# CMake out-of-source builds (build/, build-rel/, build-debug/, ...)
/build*/
# In case CMake is ever run in-source (discouraged):
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
compile_commands.json
# Fortran Package Manager, if ever used alongside CMake:
/build/

# ---- Run output (generated; keep out of the repo) ----
*.h5out
*.nc.out
*.nc
*.png
# ... but curated example figures ARE tracked. Listed one by one on purpose: `!examples/**/*.png`
# would also un-ignore every figure a user's own run drops into an example directory.
!examples/*.png
!examples/example_biophysics/biophysics_july.png
!examples/example_biophysics/carbon_july.png
!examples/example_biophysics/soil_july.png
!examples/example_biophysics/spinup_trajectory.png
!examples/example_demography/example_output.png
!examples/example_demography/example_output_pft.png
!examples/example_demography/forest3d_landscape.png
!examples/example01_leaf_gas_exchange/slot2017.png
!examples/example02_canopy_phenology/harvard_forest.png
!examples/example02_canopy_phenology/hyytiala.png
!examples/example02_canopy_phenology/bci.png
!examples/example_flux_tower_bci/forcing_qc.png
!examples/example_flux_tower_bci/lw_comparison.png
!examples/example_flux_tower_bci/evaluation.png
!examples/example_flux_tower_bci/calibration.png
# The list was short of five of these. Four were tracked anyway -- they predate the *.png rule, and
# .gitignore does not apply to a file already in the index -- so the gap was invisible until a NEW
# figure appeared: examples/example_phenology/phenology_patterns.png was silently never added, and
# its README embedded a broken image. Listing every referenced figure keeps the rule honest, and
# means deleting and regenerating one cannot quietly drop it from the repository.
# core dumps (anchored to repo root so this does NOT match the src/core/ source dir)
/core
core.*
*.log

# ---- Python artifacts (post_proc/ scripts import each other) ----
__pycache__/
.pytest_cache/
# scikit-build-core's out-of-source tree for `pip install python/` (build-dir in pyproject.toml).
# The root-level /build*/ rule above does not reach it -- that pattern is anchored at the repo root.
python/build/
*.py[cod]

# ---- Editor / OS ----
*~
*.swp
*.swo
.DS_Store
.idea/
.vscode/
*.code-workspace

# ---- Simulation run folders (setups + results, not tracked) ----
/runs/
# The flux-tower example's data and everything built from it: the BCI CSV is downloaded, never
# committed (MEDS_FLUX_TOWER_FORCING_PLAN.md D7), and so are the forcing files and runs it makes.
examples/example_flux_tower_bci/data/
examples/example_flux_tower_bci/output/
# The calibration's trials and states (calibrate_fast.py --work); its results are committed.
examples/example_flux_tower_bci/calibration/run/
# The phenology example's site data, downloaded by fetch_phenology_data.py.
examples/example02_canopy_phenology/data/

# User pre-existing WIP design (kept on disk, never committed)
docs/dev_plans/MEDS_CAPI_REORG_DESIGN.md

# ---- Machine-local Claude guidance (paths, local run dirs) ----
CLAUDE.local.md
